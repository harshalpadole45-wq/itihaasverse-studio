
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ItihaasVerse Studio V4</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;padding:15px;
  background:#101b20;color:#f5ead8;
  font-family:Arial,sans-serif
}
header{
  text-align:center;padding:15px;
  background:#263b3e;border:1px solid #bd9656;
  border-radius:12px;margin-bottom:15px
}
h1{color:#e3bc72;font-size:23px}
.card{
  background:#203239;padding:15px;
  margin-bottom:14px;border-radius:12px
}
label{display:block;margin:12px 0 6px}
input,textarea,button{
  width:100%;padding:11px;border-radius:8px;
  border:1px solid #8e7954;
  background:#15252b;color:white
}
input[type=range]{padding:0}
button{
  background:#a87938;color:white;
  font-weight:bold;border:0;margin-top:10px
}
.stage{
  width:min(100%,360px);
  aspect-ratio:9/16;
  margin:auto;background:#111;
  position:relative;overflow:hidden;
  border:2px solid #bd9656;
  border-radius:12px
}
#background{
  position:absolute;width:100%;height:100%;
  object-fit:cover;inset:0
}
#camera{
  position:absolute;inset:0;
  transform-origin:center;
}
#character{
  position:absolute;
  width:48%;height:auto;
  bottom:15%;left:50%;
  transform:translateX(-50%);
  object-fit:contain;
}
#subtitle{
  position:absolute;bottom:5%;left:5%;
  width:90%;text-align:center;
  color:white;font-size:17px;
  font-weight:bold;
  text-shadow:2px 2px 4px black;
}
#camera.moving{
  animation:cameraZoom 5s ease-in-out forwards
}
#character.enter{
  animation:characterEnter 5s ease-in-out forwards
}
@keyframes characterEnter{
  0%{left:-30%;transform:translateX(-50%) scale(.8)}
  60%{left:50%;transform:translateX(-50%) scale(1)}
  100%{left:50%;transform:translateX(-50%) scale(1)}
}
@keyframes cameraZoom{
  from{scale:1}
  to{scale:1.15}
}
.note{color:#c9c0ad;font-size:13px}
</style>
</head>

<body>

<header>
<h1>ITIHASVERSE STUDIO V4</h1>
<p>2D Animation Engine — First Prototype</p>
</header>

<div class="card">
<h3>1. Scene Assets</h3>

<label>Upload background image</label>
<input type="file" id="bgUpload" accept="image/*">

<label>Upload transparent character PNG</label>
<input type="file" id="charUpload" accept="image/png,image/webp">

<p class="note">
Use a transparent PNG character for the best result.
</p>
</div>

<div class="card">
<h3>2. Character Controls</h3>

<label>Character size</label>
<input type="range" id="size" min="15" max="90" value="48">

<label>Horizontal position</label>
<input type="range" id="position" min="5" max="95" value="50">

<label>Vertical position</label>
<input type="range" id="vertical" min="0" max="80" value="15">

<label>Camera zoom</label>
<input type="range" id="zoom" min="100" max="150" value="115">
</div>

<div class="card">
<h3>3. Scene Preview</h3>

<div class="stage">
  <div id="camera">
    <img id="background" alt="">
    <img id="character" alt="">
  </div>
  <div id="subtitle">जय श्री राम</div>
</div>

<label>Hindi subtitle</label>
<textarea id="subtitleText" rows="2">जय श्री राम</textarea>

<button id="play">▶ Play Animation</button>
<button id="reset">↺ Reset Scene</button>

<p class="note">
This version previews animation in your browser.
It does not export an MP4 yet.
</p>
</div>

<script>
const bgUpload = document.getElementById("bgUpload");
const charUpload = document.getElementById("charUpload");
const bg = document.getElementById("background");
const character = document.getElementById("character");
const camera = document.getElementById("camera");

bgUpload.addEventListener("change", e => {
  const file = e.target.files[0];
  if(file){
    bg.src = URL.createObjectURL(file);
  }
});

charUpload.addEventListener("change", e => {
  const file = e.target.files[0];
  if(file){
    character.src = URL.createObjectURL(file);
  }
});

function updateCharacter(){
  character.style.width =
    document.getElementById("size").value + "%";

  character.style.left =
    document.getElementById("position").value + "%";

  character.style.bottom =
    document.getElementById("vertical").value + "%";

  character.style.transform = "translateX(-50%)";
}

["size","position","vertical"].forEach(id=>{
  document.getElementById(id).addEventListener(
    "input",updateCharacter
  );
});

document.getElementById("zoom").addEventListener("input",e=>{
  camera.style.scale = e.target.value / 100;
});

document.getElementById("subtitleText").addEventListener("input",e=>{
  document.getElementById("subtitle").textContent = e.target.value;
});

document.getElementById("play").addEventListener("click",()=>{
  character.classList.remove("enter");
  camera.classList.remove("moving");

  void character.offsetWidth;

  character.classList.add("enter");
  camera.classList.add("moving");
});

document.getElementById("reset").addEventListener("click",()=>{
  character.classList.remove("enter");
  camera.classList.remove("moving");
  camera.style.scale = "1";
  document.getElementById("zoom").value = 100;
  updateCharacter();
});

updateCharacter();
</script>

</body>
</html>
